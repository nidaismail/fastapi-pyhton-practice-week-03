from enum import StrEnum

from fastapi import FastAPI, HTTPException

app = FastAPI(title="Noor Foods API")


class OrderStatus(StrEnum):
    PENDING = "pending"
    DELIVERED = "delivered"


ORDERS = {
    "A101": {
        "id": "A101",
        "customer": "Noor Foods",
        "total": 4500,
        "status": "pending",
    },
    "A102": {
        "id": "A102",
        "customer": "Bilal Traders",
        "total": 12800,
        "status": "delivered",
    },
    "A103": {
        "id": "A103",
        "customer": "Karachi Crafts",
        "total": 2300,
        "status": "pending",
    },
}


@app.get("/orders")
def list_orders(status: OrderStatus | None = None, limit: int = 10) -> list[dict]:
    orders = []
    for order in ORDERS.values():
        if status is None or order["status"] == status:
            orders.append(order)
    return orders[:limit]


# Practice: routes and parameters
# # Practice Task 1 - Filter by customer


@app.get("/customer/{customer}")
def get_orders(customer: str) -> list[dict]:
    results = []
    for order in ORDERS.values():
        if order["customer"] == customer.title():
            results.append(order)

    return results


# Practice Task - 2 Orders above a total
@app.get("/total")
def get_total(
    status: OrderStatus | None = None, min_total: int | None = None
) -> list[dict]:
    totals = []
    for order in ORDERS.values():
        if (min_total is not None and order["total"] < min_total) or (
            status is not None and order["status"] != status
        ):
            continue
        totals.append(order)
    return totals


# Practice Task - 3 A customer's Order
# Add a route GET /customers/{name}/orders that returns all orders for one customer. If the customer has no orders, return a 404 with a message that names the customer. When would you use this route instead of GET /orders?customer=...?
@app.get("/customers/{name}/orders")
def show_customer(name: str) -> list[dict]:
    cust = []
    for order in ORDERS.values():
        if order["customer"] == name.title():
            cust.append(order)
    if not cust:
        raise HTTPException(status_code=404, detail=f"{name} not found")
    return cust
